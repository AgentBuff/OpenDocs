{
  "name": "open-office-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:wasm && pnpm --filter @open-office/editor dev",
    "build:document-engine-wasm": "wasm-pack build ../crates/oo-document-wasm --target web --out-dir ../../web/packages/document-engine/wasm --no-pack",
    "build:mindmap-engine-wasm": "wasm-pack build ../crates/oo-mindmap-wasm --target web --out-dir ../../web/packages/mindmap-engine/wasm --no-pack",
    "build:wasm": "pnpm build:document-engine-wasm && pnpm build:mindmap-engine-wasm",
    "build": "pnpm build:wasm && pnpm --filter @open-office/editor build",
    "architecture:check": "node scripts/architecture-gate.mjs",
    "contract:check": "node ../scripts/check-generated-api-contract.mjs",
    "test": "pnpm build:wasm && vitest run",
    "typecheck": "pnpm build:wasm && tsc --build --force",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "browser:table-smoke": "node scripts/table-browser-smoke.mjs",
    "browser:visual-smoke": "node scripts/visual-smoke.mjs",
    "test:e2e": "pnpm build:wasm && playwright test",
    "test:e2e:update": "pnpm build:wasm && playwright test --update-snapshots",
    "test:visual": "pnpm build:wasm && playwright test e2e/visual",
    "bench:editor": "node scripts/bench-editor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
