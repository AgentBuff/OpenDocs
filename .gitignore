# -----------------------------------------------------------------------------
# Local dependencies and build outputs
# -----------------------------------------------------------------------------
/target/
**/node_modules/
/.pnpm-store/
/.vite/
**/dist/
**/coverage/
*.tsbuildinfo
/.codegraph/

# Generated browser bindings are rebuilt from crates/oo-document-wasm.
/web/packages/document-engine/wasm/*
!/web/packages/document-engine/wasm/.gitignore

# Generated mindmap bindings are rebuilt from crates/oo-mindmap-wasm.
/web/packages/mindmap-engine/wasm/*

# -----------------------------------------------------------------------------
# Local runtime state and secrets
# -----------------------------------------------------------------------------
/data/
/data/schema-backup/
/.e2e-data/
/.dev-data/
/web/test-results/
/web/playwright-report/
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example
*.pem
*.key

# -----------------------------------------------------------------------------
# AI-agent workspace material (local prompts, plans and traces).
# AGENTS.md and CLAUDE.md are tracked project instructions.
# -----------------------------------------------------------------------------
/.agents/
/.codex/
/.claude/
/.cursor/
/.workbuddy-ai/
/task_plan.md
/progress.md
/findings.md
/prompts/
/prompt/
/.prompts/
/.prompt/

# -----------------------------------------------------------------------------
# Internal design, planning and decision records are kept out of the repository.
# Generated API contract artifacts do NOT live here: they are tracked under
# scripts/generated/ so the contract drift check works on a clean checkout.
# -----------------------------------------------------------------------------
/docs/

# Frozen third-party research and pre-cutover snapshots are not product source.
/freeze/

# -----------------------------------------------------------------------------
# OS/editor noise
# -----------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Vitest writes a throwaway config shim next to vitest.config.ts and does not
# always clean it up when the run is interrupted.
/web/vitest.config.ts.timestamp-*.mjs

# Reproducible font download metadata cache
/web/scripts/fonts/.cache/

# Downloaded Fontsource WOFF2 faces; reproduce with web/scripts/fonts/acquire.py.
/web/apps/editor/public/fonts/
