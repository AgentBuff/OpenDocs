# open-office configuration reference.
#
# Nothing here is required: every value below has a working default and the
# server plus the dev tooling start with no .env file at all. Copy this file to
# `.env` (git-ignored) only when you need to override something, and keep the
# real `.env` local — it must never be committed.
#
# The server reads its configuration from the process environment, not from this
# file. Load it yourself when running the server, for example:
#
#   set -a && source .env && set +a && cargo run -p oo-server
#
# The Vite dev server and the Node scripts read their variables from the
# environment too; the same `source` pattern applies.

# -----------------------------------------------------------------------------
# oo-server runtime
# -----------------------------------------------------------------------------

# Listen address. Default: 127.0.0.1:8787
# OO_BIND=127.0.0.1:8787

# Directory holding the SQLite database and the blob store. Default: ./data
# OO_DATA_DIR=./data

# SQLite connection string. Default: sqlite://<OO_DATA_DIR>/open-office.db
# OO_DATABASE_URL=sqlite://./data/open-office.db

# Log filter, in tracing EnvFilter syntax. Default: info
# RUST_LOG=info

# Destructive maintenance switches. Both default to off and are only meant to be
# set after taking a backup; see crates/oo-server/src/bin/.
#
# Delete blobs no longer referenced by any snapshot at server start-up.
# OO_ENABLE_BLOB_GC=1
# Allow `cargo run -p oo-server --bin gc-assets` to reclaim asset files.
# OO_ENABLE_ASSET_GC=1

# -----------------------------------------------------------------------------
# Local development and browser tooling
# -----------------------------------------------------------------------------

# Upstream API origin the Vite dev server proxies /api to.
# Default: http://127.0.0.1:8787
# OO_API=http://127.0.0.1:8787

# Base URL used by the Node smoke/bench scripts. Must point at a disposable,
# writable artifact so the probes never touch a document you are editing.
# OO_EDITOR_URL=http://127.0.0.1:5174/?doc=<fixture-id>

# API origin used by scripts/fault-injection.mjs. Default: http://127.0.0.1:8787
# OO_API_URL=http://127.0.0.1:8787

# Disposable artifact id for scripts/fault-injection.mjs.
# OO_ARTIFACT_ID=<disposable-id>

# Screenshot destination for the visual smoke run.
# Default: /tmp/open-office-editor.png
# OO_VISUAL_OUTPUT=/tmp/open-office-editor.png

# -----------------------------------------------------------------------------
# Audit and contract tooling
# -----------------------------------------------------------------------------

# Write the dependency audit result as JSON to this path in addition to stdout.
# OO_DEPENDENCY_REPORT=./dependency-report.json

# Make a missing cargo-audit / pnpm scanner a hard failure instead of a warning.
# CI sets this to 1; leave it unset locally if you only have one of the scanners.
# OO_REQUIRE_DEPENDENCY_SCANNERS=1

# Rewrite the checked-in protocol contract snapshot instead of asserting on it.
# Only set this when you intentionally changed the wire contract.
# UPDATE_CONTRACT_SNAPSHOT=1

# -----------------------------------------------------------------------------
# Benchmarks (crates/*/benches)
# -----------------------------------------------------------------------------

# OO_BENCH_BLOCKS=2000
# OO_BENCH_CELLS=2000
# OO_BENCH_FORMULAS=200
# OO_BENCH_ITERATIONS=20
# OO_BENCH_PRESENTATION_NODES=500
# OO_BENCH_PRESENTATION_SLIDES=50
