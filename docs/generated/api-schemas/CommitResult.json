{
  "description": "所有 Artifact 写入的唯一提交返回值。",
  "properties": {
    "artifactId": {
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/components/schemas/DomainEventRecord"
      },
      "type": "array"
    },
    "invalidation": {
      "$ref": "#/components/schemas/Invalidation"
    },
    "mutations": {
      "items": {
        "$ref": "#/components/schemas/MutationRecord"
      },
      "type": "array"
    },
    "protocolVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "transactionId": {
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "artifactId",
    "transactionId",
    "revision",
    "invalidation",
    "mutations",
    "events"
  ],
  "type": "object"
}
