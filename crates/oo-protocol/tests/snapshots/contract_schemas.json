      "transport",
      "artifacts"
    ],
    "title": "CapabilityCatalog",
    "type": "object"
  },
  "CommandRecord": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Command 是用户意图；payload 由对应 Artifact capability 负责校验。",
    "properties": {
      "commandId": {
        "type": "string"
      },
      "payload": true,
      "typeId": {
        "type": "string"
      }
    },
    "required": [
      "commandId",
      "typeId",
      "payload"
    ],
    "title": "CommandRecord",
    "type": "object"
  },
  "CommitResult": {
    "$defs": {
      "DomainEventRecord": {
        "description": "提交后的领域事实。事件只能在事务成功提交后产生。",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "payload": true,
          "typeId": {
            "type": "string"
          }
        },
        "required": [
          "eventId",
          "typeId",
          "payload"
        ],
        "type": "object"
      },
      "EntityRef": {
        "properties": {
          "entityId": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          }
        },
        "required": [
          "entityType",
          "entityId"
        ],
        "type": "object"
      },
      "Invalidation": {
        "description": "只表达增量失效范围，不携带完整 snapshot。",
        "properties": {
          "changedContainers": {
            "items": {
              "$ref": "#/$defs/EntityRef"
            },
            "type": "array"
          },
          "changedEntities": {
            "items": {
              "$ref": "#/$defs/EntityRef"
            },
            "type": "array"
          },
          "structureChanged": {
            "type": "boolean"
          }
        },
        "required": [
          "changedEntities",
          "changedContainers",
          "structureChanged"
        ],
        "type": "object"
      },
      "MutationRecord": {
        "description": "跨 Artifact 的最小持久化变更记录。具体 payload 由 Mutation registry 解释。",
        "properties": {
          "payload": true,
          "typeId": {
            "type": "string"
          }
        },
        "required": [
          "typeId",
          "payload"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "所有 Artifact 写入的唯一提交返回值。",
    "properties": {
      "artifactId": {
        "type": "string"
      },
      "events": {
        "items": {
          "$ref": "#/$defs/DomainEventRecord"
        },
        "type": "array"
      },
      "invalidation": {
        "$ref": "#/$defs/Invalidation"
      },
      "mutations": {
        "items": {
          "$ref": "#/$defs/MutationRecord"
        },
        "type": "array"
      },
      "protocolVersion": {
        "format": "uint16",
        "maximum": 65535,
        "minimum": 0,
        "type": "integer"
      },
      "revision": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "transactionId": {
        "type": "string"
      }
    },
    "required": [
      "protocolVersion",
      "artifactId",
      "transactionId",
      "revision",
      "invalidation",
      "mutations",
      "events"
    ],
    "title": "CommitResult",
    "type": "object"
  },
  "DomainEventRecord": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "提交后的领域事实。事件只能在事务成功提交后产生。",
    "properties": {
      "eventId": {
        "type": "string"
      },
      "payload": true,
      "typeId": {
        "type": "string"
      }
    },
    "required": [
      "eventId",
      "typeId",
      "payload"
    ],
    "title": "DomainEventRecord",
    "type": "object"
  },
  "EntityRef": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "entityId": {
        "type": "string"
      },
      "entityType": {
        "type": "string"
      }
    },
    "required": [
      "entityType",
      "entityId"
    ],
    "title": "EntityRef",
    "type": "object"
  },
  "Invalidation": {
    "$defs": {
      "EntityRef": {
        "properties": {
          "entityId": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          }
        },
        "required": [
          "entityType",
          "entityId"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "只表达增量失效范围，不携带完整 snapshot。",
    "properties": {
      "changedContainers": {
        "items": {
          "$ref": "#/$defs/EntityRef"
        },
        "type": "array"
      },
      "changedEntities": {
        "items": {
          "$ref": "#/$defs/EntityRef"
        },
        "type": "array"
      },
      "structureChanged": {
        "type": "boolean"
      }
    },
    "required": [
      "changedEntities",
      "changedContainers",
      "structureChanged"
    ],
    "title": "Invalidation",
    "type": "object"
  },
  "MutationRecord": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "跨 Artifact 的最小持久化变更记录。具体 payload 由 Mutation registry 解释。",
    "properties": {
      "payload": true,
      "typeId": {
        "type": "string"
      }
    },
    "required": [
      "typeId",
      "payload"
    ],
    "title": "MutationRecord",
    "type": "object"
  },
  "OperationRecord": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Operation 表示不进入 Artifact snapshot 的视图/协同状态，例如选区和滚动位置。\n它与 CommandRecord 有意使用不同的 ID 字段，避免把临时状态误当成持久化意图。",
    "properties": {
      "operationId": {
        "type": "string"
      },
      "payload": true,
      "typeId": {
        "type": "string"
      }
    },
    "required": [
      "operationId",
      "typeId",
      "payload"
    ],
    "title": "OperationRecord",
    "type": "object"
  },
  "TransactionOrigin": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "enum": [
      "local",
      "remote",
      "undo",
      "redo",
      "import",
      "system"
    ],
    "title": "TransactionOrigin",
    "type": "string"
  }
}
